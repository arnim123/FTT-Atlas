{
  "name": "atlas-knowledge",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 0.0.0.0",
    "typecheck": "tsc -b --pretty false",
    "test": "node --test tests/*.test.mjs",
    "test:smoke": "node scripts/smoke.mjs",
    "test:e2e": "playwright test",
    "openapi": "cd ../backend && .venv/bin/python -c \"import json; from app.main import app; open('openapi.json','w').write(json.dumps(app.openapi()))\" && cd ../frontend && openapi-typescript ../backend/openapi.json -o src/api/schema.d.ts"
  },
  "dependencies": {
    "@fontsource/inter": "5.2.8",
    "@hookform/resolvers": "5.2.2",
    "@radix-ui/react-checkbox": "1.3.3",
    "@radix-ui/react-dialog": "1.1.15",
    "@radix-ui/react-dropdown-menu": "2.1.16",
    "@radix-ui/react-slot": "1.2.3",
    "@radix-ui/react-tabs": "1.1.13",
    "@radix-ui/react-tooltip": "1.2.8",
    "@tanstack/react-query": "5.101.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "lucide-react": "0.562.0",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-hook-form": "7.70.0",
    "react-router-dom": "^6.30.6",
    "recharts": "2.15.4",
    "sonner": "2.0.7",
    "tailwind-merge": "3.4.0",
    "tailwindcss-animate": "^1.0.7",
    "zod": "^4.6.7",
    "zustand": "5.0.14"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.1",
    "@types/node": "22.20.0",
    "@types/react": "18.3.31",
    "@types/react-dom": "18.3.7",
    "@vitejs/plugin-react": "4.7.0",
    "autoprefixer": "10.4.23",
    "esbuild": "0.21.5",
    "openapi-typescript": "^7.10.1",
    "postcss": "^8.5.33",
    "tailwindcss": "3.4.19",
    "typescript": "5.9.3",
    "vite": "5.4.21"
  },
  "optionalDependencies": {
    "@dnd-kit/core": "6.3.1"
  },
  "engines": {
    "node": ">=22"
  }
}
