# false talks to the API. true keeps the in-browser demo.
VITE_USE_MOCKS=false
# Leave empty so the Vite dev server proxies /api, /oauth, /.well-known, and /mcp.
VITE_API_BASE_URL=
# true only for the Playwright suite. The API must also set ALLOW_TEST_LOGIN=true.
VITE_ENABLE_TEST_LOGIN=false
# Optional. The signed-in app reads the client id from GET /api/v1/config.
VITE_GOOGLE_CLIENT_ID=
